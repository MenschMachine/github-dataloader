# GitHub Personal Access Token (required)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, actions:read
GITHUB_TOKEN=

# Cloudflare R2 Access Keys (required for upload, not needed with --local-only)
# IMPORTANT: Use R2 Access Keys, NOT Cloudflare API tokens!
# Generate in Cloudflare Dashboard: R2 > Manage R2 API Tokens > Create API Token
# Access Key ID should be 32 characters
R2_ACCESS_KEY_ID=

# Secret Access Key from R2 (usually 43 characters)
R2_SECRET_ACCESS_KEY=

# Your Cloudflare Account ID (found in R2 overview page)
R2_ACCOUNT_ID=

# Your R2 bucket name
R2_BUCKET_NAME=
